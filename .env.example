# Copie este arquivo para .env (ou cadastre as variáveis na hospedagem) antes de publicar.
PORT=8080

# Endereço da área administrativa: https://SEU-SITE/<este-valor>/  (padrão: use-admin)
# O editor do mapa fica em https://SEU-SITE/<este-valor>/editor
BUZU_PAINEL_CAMINHO=use-admin

# Contas da área administrativa (uma por pessoa), separadas por ";".
# Cada pessoa gera a SUA linha no próprio computador com:
#     node scripts/admin/criar-usuario.js
# A linha tem o hash da senha (a senha nunca fica salva) e a chave da verificação em duas etapas.
# Nunca coloque o .env real no Git.
BUZU_ADMIN_USUARIOS=

# Opcional: defina como 1 para desabilitar completamente a área administrativa neste servidor
BUZU_PUBLIC_READONLY=0

# Endereço oficial do site. Visitas pelos endereços antigos são redirecionadas (301) para ele.
BUZU_DOMINIO_PRINCIPAL=rotasnatal.com.br
# Endereços antigos (separados por vírgula) que devem ser levados para o endereço oficial
BUZU_DOMINIOS_ANTIGOS=rotasnatal.vertraweb.app,buzurotanat.vertraweb.app,www.rotasnatal.com.br
