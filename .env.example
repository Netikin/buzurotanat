# Copie este arquivo para .env e defina sua chave secreta antes de publicar
PORT=8080

# Chave secreta de administrador (nunca compartilhe no frontend ou Git)
BUZU_ADMIN_KEY=troque-por-uma-chave-forte-aleatoria

# Opcional: defina como 1 para desabilitar completamente o painel Admin no servidor público
BUZU_PUBLIC_READONLY=0
